# ---------------------------------------------------------------------------
# ISX Leave Management Dashboard — environment configuration
# Copy to .env.local (Next.js) / .env (scripts) and fill in.
# NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# Owner/migration connection. Full DDL rights. Used ONLY by scripts
# (migrate / seed / create-admin / import-holidays). Not used at runtime.
DATABASE_URL=postgres://isx_owner:isx_owner_pw@localhost:5432/isx_leave

# Runtime connection. This role is NOT the table owner and does NOT have
# BYPASSRLS, so every query the web app makes is filtered by Row Level Security.
DATABASE_APP_URL=postgres://isx_app:isx_app_pw@localhost:5432/isx_leave

# 32+ char random secret used to sign session JWTs.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

APP_URL=http://localhost:3000

# Session lifetime in seconds (default 8h)
SESSION_TTL_SECONDS=28800

# Bootstrap admin (consumed by `npm run admin:create`, never shipped to client)
SETUP_ADMIN_NAME=ISX Administrator
SETUP_ADMIN_EMAIL=admin@isx.co.th
SETUP_ADMIN_PASSWORD=

# Company defaults
DEFAULT_ANNUAL_ENTITLEMENT=15
COMPANY_TIMEZONE=Asia/Bangkok

# Enable /api/demo-login and seeded demo passwords. MUST be false in production.
DEMO_MODE=true
